rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assets collection - only the designated admin can create, update, or delete assets
    match /assets/{assetId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'murthy@topin.co.in' ||
        resource.data.owner == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email
      );
      allow create, update, delete: if request.auth != null && request.auth.token.email == 'murthy@topin.co.in';
    }
    
    // Asset Requests collection - users can create and read their own, admin can read/update all
    match /assetRequests/{requestId} {
      // Users can create requests
      allow create: if request.auth != null;
      
      // Users can read their own requests, admin can read all
      allow read: if request.auth != null && (
        resource.data.requesterId == request.auth.uid ||
        request.auth.token.email == 'murthy@topin.co.in'
      );
      
      // Admin can update requests (status changes, notes, etc.)
      // Users can update their own requests (add comments)
      allow update: if request.auth != null && (
        resource.data.requesterId == request.auth.uid ||
        request.auth.token.email == 'murthy@topin.co.in'
      );
    }
    
    // Incidents collection - authenticated users can create incidents, and users/admins can read/update relevant records
    match /incidents/{incidentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.reporterId == request.auth.uid ||
        request.auth.token.email == 'murthy@topin.co.in'
      );
      allow update: if request.auth != null && (
        resource.data.reporterId == request.auth.uid ||
        request.auth.token.email == 'murthy@topin.co.in'
      );
    }

    // Users collection - allow users to create/read/update their own profile
    match /users/{userId} {
      // Allow authenticated users to create their own user document
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow users to read their own profile; admin can read all
      allow read: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.email == 'murthy@topin.co.in'
      );
      // Allow users to update their own profile; admin can also update
      allow update: if request.auth != null && (
        request.auth.uid == userId || request.auth.token.email == 'murthy@topin.co.in'
      );
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == 'murthy@topin.co.in';
      allow update, delete: if false;
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null && counterId == 'incidents';
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
